<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js';

const canvas=document.querySelector('#scene');
const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);
renderer.setClearColor(0x05070b,1);
const scene=new THREE.Scene();
scene.fog=new THREE.FogExp2(0x05070b,.032);
const camera=new THREE.PerspectiveCamera(55,innerWidth/innerHeight,.1,200);camera.position.set(0,1.5,18);
scene.add(new THREE.AmbientLight(0x7890ff,.55));
const key=new THREE.PointLight(0x5eeaff,24,50);key.position.set(5,6,9);scene.add(key);
const fill=new THREE.PointLight(0x9f7aea,18,40);fill.position.set(-7,1,5);scene.add(fill);

const group=new THREE.Group();scene.add(group);
const grid=new THREE.GridHelper(70,35,0x24405d,0x122338);grid.position.y=-4;grid.rotation.x=0;group.add(grid);
const rings=[];
for(let i=0;i<7;i++){
  const g=new THREE.TorusGeometry(2.7+i*.65,.008,8,96);
  const m=new THREE.MeshBasicMaterial({color:i%2?0x536dff:0x4de3ee,transparent:true,opacity:.22});
  const r=new THREE.Mesh(g,m);r.rotation.x=Math.PI/2;r.position.y=-2+i*.35;r.position.z=-2-i*1.2;group.add(r);rings.push(r);
}
const particleGeo=new THREE.BufferGeometry(),count=900,positions=new Float32Array(count*3);
for(let i=0;i<count;i++){positions[i*3]=(Math.random()-.5)*55;positions[i*3+1]=(Math.random()-.5)*28;positions[i*3+2]=(Math.random()-.5)*45-8}
particleGeo.setAttribute('position',new THREE.BufferAttribute(positions,3));
const points=new THREE.Points(particleGeo,new THREE.PointsMaterial({color:0x83b7ff,size:.035,transparent:true,opacity:.7}));
scene.add(points);

const wireMat=new THREE.MeshBasicMaterial({color:0x5eeaff,wireframe:true,transparent:true,opacity:.12});
for(let i=0;i<18;i++){
  const s=THREE.MathUtils.randFloat(.35,1.4);
  const geo=i%2?new THREE.IcosahedronGeometry(s,1):new THREE.BoxGeometry(s,s,s);
  const mesh=new THREE.Mesh(geo,wireMat.clone());
  mesh.position.set((Math.random()-.5)*28,(Math.random()-.5)*13,(Math.random()-.5)*25-7);
  mesh.rotation.set(Math.random()*6,Math.random()*6,Math.random()*6);
  group.add(mesh);
}
let mx=0,my=0,tx=0,ty=0;
addEventListener('pointermove',e=>{tx=(e.clientX/innerWidth-.5);ty=(e.clientY/innerHeight-.5)});
addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});
const clock=new THREE.Clock();
function animate(){
  requestAnimationFrame(animate);const t=clock.getElapsedTime();
  mx+=(tx-mx)*.035;my+=(ty-my)*.035;
  camera.position.x=mx*2.5;camera.position.y=1.5-my*1.7;camera.lookAt(mx*.7,-.4,-3);
  group.rotation.y=mx*.12;group.rotation.x=-my*.04;
  points.rotation.y=t*.006;points.rotation.x=t*.002;
  rings.forEach((r,i)=>{r.rotation.z=t*(.03+i*.004)*(i%2?-1:1);r.material.opacity=.13+.09*Math.sin(t+i)});
  renderer.render(scene,camera);
}
animate();

const io=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('show')}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
</script>
